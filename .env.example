# Copy to .env and fill in. Never commit .env. Placeholders only in this file.
#
# Sponsor credentials (Zetaris, Meterless, NVIDIA, Bright Data) are added here
# only after their variable names are confirmed from the sponsor documentation
# on HackOS. Do not guess them. See docs/sponsors/.

# Run without credentials, using the bundled sample data and skipping live services.
SAMPLE_MODE=true

# Runtime discipline (organizer target: a full run in 5 to 10 minutes).
MAX_AGENT_TURNS=12
MAX_TOOL_CALLS_PER_AGENT=8
MAX_RETRIES=2
EXTERNAL_CALL_TIMEOUT_SECONDS=30
RUN_WALL_CLOCK_BUDGET_SECONDS=600

# Where run traces (JSON lines, one per agent decision) are written.
TRACE_DIR=logs
LOG_LEVEL=INFO

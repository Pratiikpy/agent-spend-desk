# Copy to .env and fill in what you have. Never commit .env. Every value here is empty on purpose.
# Nothing is required: without any of this the Desk runs on the bundled sample, offline, with recorded replies.

# Language roles (drafter, attacker, planner, explainer) and the canary run on NVIDIA Nemotron through
# NVIDIA's OpenAI-compatible API. The code is the same for any OpenAI-compatible endpoint: only these three change.
# The organizers' names work too and win when both are set: MODEL_BASE_URL, MODEL_API_KEY, NEMOTRON_MODEL.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
MODEL_BASE_URL=
MODEL_API_KEY=
NEMOTRON_MODEL=
# Optional: a different model for a role, as role=model pairs separated by commas; every other role uses NEMOTRON_MODEL.
# Example: DESK_ROLE_MODELS=ask_planner=<model>,explainer=<model>
DESK_ROLE_MODELS=
# Embeddings (meaning for routing a question and for finding your notes). Off unless DESK_EMBED=on, because it sends the text of
# questions and notes to the embedding endpoint. It uses the NVIDIA settings above unless these are set. In sample mode recorded
# vectors are used and nothing is sent.
DESK_EMBED=
DESK_EMBED_MODEL=
DESK_EMBED_BASE_URL=
DESK_EMBED_API_KEY=
# Optional: a second model that should not change when the first does, so the canary can tell a platform event
# from a model change.
CANARY_CONTROL_MODEL=

# Organisational sources (invoices, CI and pull requests, roster) through a local Zetaris instance.
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
ZETARIS_BASE_URL=
# Password of the synthetic CI database used by infra/silos/start-ci-silo.sh.
DESK_SILO_PG_PASSWORD=

# The spend gate. The agent value is what hooks and agents present; the owner value unlocks approve, pause and the
# emergency switch. Both need at least 16 characters; the gate will not start without the first.
DESK_GATE_TOKEN=
DESK_GATE_OWNER_TOKEN=
# Where the dossier signing key lives. It must be outside any git work tree; the default is ~/.desk/signer.key.pem.
DESK_SIGNER_KEY=

# Run on the constructed sample with recorded model replies and recorded Zetaris answers: no keys, no network.
SAMPLE_MODE=true

{
  "name": "agent-spend-desk",
  "version": "0.0.0",
  "description": "desk. ties what AI coding agents cost to the work that landed, and tests a spend policy on a month it never saw.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/engines/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "tsx scripts/run-conformance.ts",
    "ingest": "tsx src/desk/cli.ts ingest",
    "bill": "tsx src/desk/cli.ts bill",
    "desk": "tsx src/desk/cli.ts",
    "desk-verify": "node src/desk/verify/main.ts",
    "gate": "tsx src/desk/gate/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "yaml": "^2.9.1"
  }
}
